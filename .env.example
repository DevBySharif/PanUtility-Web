# Server-only key required to enable audio transcription. Never prefix it with VITE_.
GEMINI_API_KEY=""

# NODE_ENV, VERCEL, and VERCEL_ENV are validated platform-provided values; do not set them manually on Vercel.

# Comma-separated exact HTTPS production origins. No paths, trailing slashes, or wildcards.
# For local development only, add http://localhost:3000 and http://127.0.0.1:3000.
ALLOWED_ORIGINS="https://panutility.vercel.app"

# Shared Redis-compatible REST store required for production transcription rate limiting.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Server-only random secret of at least 32 characters used to HMAC client identities.
RATE_LIMIT_IDENTITY_SECRET=""

# DISABLE_HMR: Optional local-development switch. Set true only when file watching must be disabled.
DISABLE_HMR="false"
