# Zero-cost Vercel production needs no secrets or custom configuration.
# When unset, production accepts only https://omnitily.vercel.app for API CORS.
# Set this only when deploying to an explicitly approved HTTPS origin.
ALLOWED_ORIGINS="https://omnitily.vercel.app"

# Development/test only. This is false by default and must never be true in production.
# ENABLE_TRANSCRIPTION="false"

# Optional local-development switch. Set true only when file watching must be disabled.
DISABLE_HMR="false"

# Cobalt API (self-hosted social downloader backend)
# COBALT_API_URL="https://your-cobalt-instance.example/"
# COBALT_API_KEY="your-api-key-uuid"
