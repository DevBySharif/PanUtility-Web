{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "engines": { "node": ">=22 <25" },
  "type": "module",
  "scripts": {
    "dev": "node --experimental-strip-types server.ts",
    "build:client": "node scripts/build-client.mjs",
    "build:server": "node scripts/build-server.mjs",
    "build": "node scripts/build.mjs",
    "start": "node server-dist/server.cjs",
    "preview": "node node_modules/vite/bin/vite.js preview",
    "clean": "node node_modules/rimraf/dist/esm/bin.mjs dist server-dist coverage playwright-report test-results",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "lint": "node node_modules/eslint/bin/eslint.js src api lib server.ts vite.config.ts vitest.config.ts playwright.config.ts tests",
    "test": "node node_modules/vitest/vitest.mjs run",
    "test:watch": "node node_modules/vitest/vitest.mjs",
    "test:e2e": "node node_modules/@playwright/test/cli.js test",
    "verify:deployment": "node scripts/verify-deployment.mjs",
    "check": "node scripts/check.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tailwindcss/vite": "^4.1.14",
    "@types/canvas-confetti": "^1.9.0",
    "@vitejs/plugin-react": "^5.0.4",
    "canvas-confetti": "^1.9.4",
    "express": "^4.21.2",
    "gifshot": "^0.4.5",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.55.1",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.46.0",
    "@typescript-eslint/parser": "^8.46.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.0.0",
    "jsdom": "^26.0.0",
    "postcss": "^8.5.18",
    "rimraf": "^6.0.0",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.46.0",
    "vite": "^6.2.3",
    "vitest": "^3.2.6"
  }
}
